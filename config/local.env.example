# Role this node plays in the mesh: host, client, or both.
NODE_ROLE=

# Absolute path where per-project workspaces live (host-only).
WORKSPACES_DIR=$HOME/workspaces

# Set to 1 to allow a manually configured sshd fallback (host-only, default 0).
FALLBACK_SSHD=0

# The login account for reaching a host over SSH: on a host, the account
# Claude Code sessions run under; on a client, the account connect.sh's
# `tailscale ssh` targets on the remote host (default: current login
# user). Never root.
SSH_USER=
