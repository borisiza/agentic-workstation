{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "statusMessage": "Verificando graphify hook-guard (read)"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "statusMessage": "Verificando graphify hook-guard (search)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/bmad-next-nudge.sh\"",
            "statusMessage": "Checkpoint de sesión BMAD (SessionStart)"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/scripts/bmad-precompact-lecciones.sh\"",
            "statusMessage": "Verificando lecciones antes de compactar"
          }
        ]
      }
    ]
  }
}
